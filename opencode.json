{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "model": "opencode-go/deepseek-v4-pro",
  "agent": {
    "plan": {
      "mode": "primary",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "build": {
      "mode": "primary",
      "variant": "high",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "build-lite": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "medium",
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  },
  "mcp": {
    "servers": {
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "rulesync": {
        "type": "local",
        "command": [
          "pnpm",
          "dev",
          "mcp"
        ],
        "environment": {}
      }
    }
  },
  "share": "disabled",
  "instructions": [
    ".github/workflows/AGENTS.md",
    ".opencode/memories/coding-guidelines.md",
    ".opencode/memories/feature-change-guidelines.md",
    ".opencode/memories/testing-guidelines.md"
  ]
}
